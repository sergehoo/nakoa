# ==============================================================================
# Nakoa (PrintHub) — Variables d'environnement Production
# ==============================================================================
# Copier vers `.env.prod` puis remplir.
#   cp .env.prod.example .env.prod
#   chmod 600 .env.prod
# ==============================================================================

# --- Domaine / Traefik -------------------------------------------------------
NAKOA_HOST=nakoahub.com
# Domaines automatiquement gérés : api.${NAKOA_HOST}, ws.${NAKOA_HOST},
# adminer.${NAKOA_HOST}, minio.${NAKOA_HOST}, minio-console.${NAKOA_HOST}
VERSION=latest

# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING_50_CHARS_MIN
DJANGO_ALLOWED_HOSTS=nakoahub.com,www.nakoahub.com,api.nakoahub.com,ws.nakoahub.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://nakoahub.com,https://www.nakoahub.com,https://api.nakoahub.com
DJANGO_DEBUG=False
DJANGO_LOG_LEVEL=INFO

# CORS — autoriser le frontend et l'app mobile
CORS_ALLOWED_ORIGINS=https://nakoahub.com,https://www.nakoahub.com
CORS_ALLOW_CREDENTIALS=True

# --- Base de données --------------------------------------------------------
POSTGRES_DB=nakoa
POSTGRES_USER=nakoa
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# URL utilisée par Django (hostname = nom du service compose)
DATABASE_URL=postgis://nakoa:CHANGE_ME_STRONG_DB_PASSWORD@nakoaDB:5432/nakoa

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://nakoaredis:6379/0
CELERY_BROKER_URL=redis://nakoaredis:6379/1
CELERY_RESULT_BACKEND=redis://nakoaredis:6379/2
CHANNEL_LAYERS_REDIS=redis://nakoaredis:6379/3

# --- MinIO / S3 --------------------------------------------------------------
MINIO_ROOT_USER=nakoa-s3-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_STRONG_S3_PASSWORD
AWS_S3_ACCESS_KEY_ID=nakoa-s3-admin
AWS_S3_SECRET_ACCESS_KEY=CHANGE_ME_STRONG_S3_PASSWORD
AWS_S3_ENDPOINT_URL=https://minio.nakoahub.com
AWS_STORAGE_BUCKET_NAME=nakoa-media
AWS_S3_REGION_NAME=us-east-1
AWS_DEFAULT_ACL=private
AWS_QUERYSTRING_AUTH=True
AWS_S3_FILE_OVERWRITE=False

# --- Email / SMTP ------------------------------------------------------------
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=CHANGE_ME_SENDGRID_KEY
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Nakoa <no-reply@nakoahub.com>
SERVER_EMAIL=ops@nakoahub.com

# --- Notifications SMS / WhatsApp -------------------------------------------
AFRICASTALKING_USERNAME=nakoa
AFRICASTALKING_API_KEY=CHANGE_ME
AFRICASTALKING_SENDER_ID=NAKOA

WHATSAPP_VERIFY_TOKEN=CHANGE_ME_RANDOM
WHATSAPP_ACCESS_TOKEN=CHANGE_ME_META_TOKEN
WHATSAPP_PHONE_NUMBER_ID=CHANGE_ME_META_PHONE_ID
WHATSAPP_BUSINESS_ACCOUNT_ID=CHANGE_ME_META_BUSINESS_ID

# --- Push (FCM) --------------------------------------------------------------
FCM_SERVER_KEY=CHANGE_ME
FCM_CREDENTIALS_JSON=/run/secrets/fcm.json

# --- IA — multi-provider ----------------------------------------------------
AI_DEFAULT_PROVIDER=anthropic
OPENAI_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY
ANTHROPIC_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY
OLLAMA_BASE_URL=http://ollama:11434
REPLICATE_API_TOKEN=CHANGE_ME_OR_LEAVE_EMPTY
STABILITY_API_KEY=CHANGE_ME_OR_LEAVE_EMPTY

# --- Paiements --------------------------------------------------------------
# CinetPay (CI/UEMOA)
CINETPAY_API_KEY=CHANGE_ME
CINETPAY_SITE_ID=CHANGE_ME
CINETPAY_SECRET_KEY=CHANGE_ME

# Wave (CI/SN)
WAVE_API_KEY=CHANGE_ME
WAVE_WEBHOOK_SECRET=CHANGE_ME

# Orange Money
OM_CLIENT_ID=CHANGE_ME
OM_CLIENT_SECRET=CHANGE_ME

# MTN MoMo
MTN_MOMO_SUBSCRIPTION_KEY=CHANGE_ME
MTN_MOMO_API_USER=CHANGE_ME
MTN_MOMO_API_KEY=CHANGE_ME

# Stripe (international)
STRIPE_PUBLIC_KEY=pk_live_CHANGE_ME
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# --- Sentry / Observabilité -------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# --- Sécurité ---------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True

# --- Adminer Basic Auth (Traefik) -------------------------------------------
# Générer : htpasswd -nb admin <password> | sed -e s/\\$/\\$\\$/g
ADMINER_BASIC_AUTH=admin:$$apr1$$REPLACE$$ME
