# ===== Django =====
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production-please-very-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api.printhub.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://api.printhub.local

# ===== Database =====
DATABASE_URL=postgres://printhub:printhub@postgres:5432/printhub
POSTGRES_DB=printhub
POSTGRES_USER=printhub
POSTGRES_PASSWORD=printhub

# ===== Redis =====
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CHANNEL_LAYERS_URL=redis://redis:6379/3

# ===== MinIO / S3 =====
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_ACCESS_KEY_ID=printhub
AWS_S3_SECRET_ACCESS_KEY=printhub-secret-key
AWS_STORAGE_BUCKET_NAME=printhub-media
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=0

# ===== Elasticsearch =====
ELASTICSEARCH_URL=http://elasticsearch:9200

# ===== JWT =====
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=30
JWT_SIGNING_ALGORITHM=HS256

# ===== Email =====
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=PrintHub <no-reply@printhub.io>
ANYMAIL_SENDGRID_API_KEY=

# ===== SMS (Africa's Talking) =====
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=PrintHub
SMS_BACKEND=printhub.notifications.backends.AfricasTalkingBackend

# ===== WhatsApp Business =====
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ===== FCM (Firebase Push) =====
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# ===== AI =====
AI_BACKEND=auto
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.1:8b
AI_RATE_LIMIT_RPM=60

# ===== Payments =====
PLATFORM_DEFAULT_CURRENCY=XOF
PLATFORM_COMMISSION_PERCENT=10

STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

CINETPAY_API_KEY=
CINETPAY_SITE_ID=
CINETPAY_SECRET=
CINETPAY_NOTIFY_URL=https://api.printhub.io/api/v1/webhooks/cinetpay/
CINETPAY_RETURN_URL=https://app.printhub.io/orders/return

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_HASH=

WAVE_API_KEY=
WAVE_BUSINESS_ID=

ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=

MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_SUBSCRIPTION_KEY=

# ===== OAuth =====
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ===== Sentry =====
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT=dev

# ===== Misc =====
PLATFORM_NAME=PrintHub
PLATFORM_URL=https://app.printhub.io
SUPPORT_EMAIL=support@printhub.io
