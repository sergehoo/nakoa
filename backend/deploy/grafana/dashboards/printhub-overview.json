{
  "dashboard": {
    "title": "PrintHub — Vue d'ensemble",
    "tags": ["printhub", "production"],
    "timezone": "Africa/Abidjan",
    "refresh": "30s",
    "panels": [
      {
        "type": "stat",
        "title": "GMV 30j (XOF)",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "printhub_gmv_30d_xof"}]
      },
      {
        "type": "stat",
        "title": "Commandes en production",
        "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "printhub_orders_in_production"}]
      },
      {
        "type": "stat",
        "title": "Imprimeurs actifs",
        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "printhub_active_printers"}]
      },
      {
        "type": "stat",
        "title": "Latence API P95",
        "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
        "targets": [{"expr": "histogram_quantile(0.95, sum(rate(django_http_requests_latency_seconds_bucket[5m])) by (le))"}]
      },
      {
        "type": "timeseries",
        "title": "Requêtes HTTP par statut",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [{"expr": "sum(rate(django_http_responses_total_by_status_total[5m])) by (status)"}]
      },
      {
        "type": "timeseries",
        "title": "Queues Celery",
        "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
        "targets": [{"expr": "celery_queue_length"}]
      }
    ]
  }
}
