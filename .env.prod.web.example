# ==============================================================================
# Nakoa Web (Next.js) — Variables d'environnement Production
# ==============================================================================
# Copier vers `.env.prod.web` puis remplir.
# Toutes les variables `NEXT_PUBLIC_*` sont injectées dans le bundle client.
# ==============================================================================

NEXT_PUBLIC_APP_NAME=Nakoa
NEXT_PUBLIC_APP_URL=https://nakoahub.com
NEXT_PUBLIC_API_URL=https://api.nakoahub.com
NEXT_PUBLIC_WS_URL=wss://ws.nakoahub.com
NEXT_PUBLIC_DEFAULT_LOCALE=fr
NEXT_PUBLIC_SUPPORTED_LOCALES=fr,en

# Analytics (optionnel)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=nakoahub.com
NEXT_PUBLIC_SENTRY_DSN=

# Maps / OpenStreetMap (tiles publiques)
NEXT_PUBLIC_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Build-time
NEXT_TELEMETRY_DISABLED=1
